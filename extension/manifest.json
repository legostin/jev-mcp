{
  "manifest_version": 3,
  "name": "JEV Browser",
  "description": "Lets the local jev daemon drive this Chrome with JEV decisions. Shows tasks, questions and controls in the side panel.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "storage", "sidePanel", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "JEV Browser" },
  "icons": { "128": "icon128.png" }
}
